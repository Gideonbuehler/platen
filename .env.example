# --- Core ---
NODE_ENV=production
PORT=3000
# Public URL the mobile app and share links use. MUST be reachable from your phone.
PUBLIC_URL=http://tower.local:2283

# --- Secrets (CHANGE THESE) ---
# openssl rand -hex 32
JWT_SECRET=replace-me-with-32-bytes-of-hex
POSTGRES_PASSWORD=replace-me

# --- Database ---
DATABASE_URL=postgres://aperture:replace-me@aperture-db:5432/aperture

# --- Storage (mapped to Unraid shares) ---
LIBRARY_PATH=/data/library
THUMBS_PATH=/data/thumbs
UPLOAD_TMP_PATH=/data/tmp

# --- Behaviour ---
# Allow new users to self-register. Off by default; admin invites instead.
ALLOW_REGISTRATION=false
# Worker concurrency for thumbnails / transcode / embeddings
JOB_CONCURRENCY=3
# Set to false to skip CLIP model download and disable semantic search
ENABLE_ML=true
ML_MODEL=Xenova/clip-vit-base-patch32

# --- People (optional) -----------------------------------------------------
# Face detection and grouping. Another ~190 MB of models and real CPU per photo.
ENABLE_FACES=false
# Detector confidence floor. Below ~0.7 you start collecting things that merely
# look like faces (a motorcycle wheel scored 0.61 during testing).
FACE_MIN_SCORE=0.7
# Similarity above which two faces are treated as the same person.
FACE_MATCH_THRESHOLD=0.38
# Faces a person needs before they appear in the UI.
FACE_MIN_CLUSTER_SIZE=2

# --- External libraries (optional) ------------------------------------------
# An existing photo folder to index in place. Nothing is copied or modified;
# the mount is read-only so Aperture cannot write here even by mistake.
EXTERNAL_PATH=/mnt/user/photos
# How often each library is re-scanned, in minutes.
EXTERNAL_SCAN_INTERVAL_MINUTES=360
