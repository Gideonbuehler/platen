# --- Core ---
NODE_ENV=production
PORT=3000
# Public URL the mobile app and share links use. MUST be reachable from your phone.
PUBLIC_URL=http://tower.local:2283

# --- Secrets (CHANGE THESE) ---
# openssl rand -hex 32
JWT_SECRET=replace-me-with-32-bytes-of-hex
POSTGRES_PASSWORD=replace-me

# --- Database ---
DATABASE_URL=postgres://aperture:replace-me@aperture-db:5432/aperture

# --- Storage (mapped to Unraid shares) ---
LIBRARY_PATH=/data/library
THUMBS_PATH=/data/thumbs
UPLOAD_TMP_PATH=/data/tmp

# --- Behaviour ---
# Allow new users to self-register. Off by default; admin invites instead.
ALLOW_REGISTRATION=false
# Worker concurrency for thumbnails / transcode / embeddings
JOB_CONCURRENCY=3
# Set to false to skip CLIP model download and disable semantic search
ENABLE_ML=true
ML_MODEL=Xenova/clip-vit-base-patch32
