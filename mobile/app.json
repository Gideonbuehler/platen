{
  "expo": {
    "name": "Platen",
    "slug": "platen",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "platen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0b0b0e",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.platen.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Platen needs access to your photos so it can back them up to your own server.",
        "NSPhotoLibraryAddUsageDescription": "Platen saves photos you download from your server back to your library.",
        "_comment_ats": "Most people run Platen on a LAN address over plain HTTP. iOS blocks that by default, so local networking is explicitly permitted here. Public HTTPS deployments are unaffected.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Platen connects to your photo server on your home network.",
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "com.platen.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#f2913d"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_NETWORK_STATE",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Platen needs access to your photos so it can back them up to your own server.",
          "savePhotosPermission": "Platen saves photos you download from your server back to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
