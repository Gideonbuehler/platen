# Copy to docker/.env and fill in. Both secrets MUST be changed.
#
#   openssl rand -hex 32

# --- Secrets ---------------------------------------------------------------
JWT_SECRET=
POSTGRES_PASSWORD=

# --- Networking ------------------------------------------------------------
# Port the web UI is published on.
WEBUI_PORT=2283
# The address your PHONE uses to reach this server. Not localhost.
PUBLIC_URL=http://tower.local:2283

# --- Storage ---------------------------------------------------------------
# Originals. Point at the array share you actually back up.
LIBRARY_PATH=/mnt/user/photos
# Derivatives — regenerable, so cache/SSD is ideal and no backup is needed.
THUMBS_PATH=/mnt/user/appdata/platen/thumbs
# In-flight uploads. Same filesystem as LIBRARY_PATH avoids a cross-device copy.
UPLOAD_TMP_PATH=/mnt/user/appdata/platen/tmp
# Postgres data directory.
DB_PATH=/mnt/user/appdata/platen/db
# Cached CLIP weights (~250 MB), so they download only once.
ML_CACHE_PATH=/mnt/user/appdata/platen/ml-cache

# --- Behaviour -------------------------------------------------------------
ALLOW_REGISTRATION=false
ENABLE_ML=true

# --- People (optional) -----------------------------------------------------
# Face detection and grouping. Another ~190 MB of models and real CPU per photo.
ENABLE_FACES=false
# Detector confidence floor. Below ~0.7 you start collecting things that merely
# look like faces (a motorcycle wheel scored 0.61 during testing).
FACE_MIN_SCORE=0.7
# Similarity above which two faces are treated as the same person.
FACE_MATCH_THRESHOLD=0.38
# Faces a person needs before they appear in the UI.
FACE_MIN_CLUSTER_SIZE=2
ML_MODEL=Xenova/clip-vit-base-patch32
JOB_CONCURRENCY=3
TRASH_RETENTION_DAYS=30
TZ=UTC

# --- External libraries (optional) ------------------------------------------
# An existing photo folder to index in place. Nothing is copied or modified;
# the mount is read-only so Platen cannot write here even by mistake.
EXTERNAL_PATH=/mnt/user/photos
# How often each library is re-scanned, in minutes.
EXTERNAL_SCAN_INTERVAL_MINUTES=360

# --- Thumbnail cache (optional) ---------------------------------------------
# Redis caches thumbnails in RAM, which is a large win when your photos live on
# a spinning array. It stores ONLY regenerable derivatives — never originals,
# never the database — so losing it costs a little speed and nothing else.
# Leave blank to run without Redis and serve everything from disk.
REDIS_URL=redis://platen-redis:6379
# Hard ceiling. Redis evicts the coldest thumbnails rather than growing.
REDIS_MAX_MEMORY=512mb
